          "request": {
            "name": "Plan a multimodal trip",
            "description": {
              "content": "Multimodal trip planning between an origin and a destination, returning ranked itineraries that combine public transit with walking, biking, and shared mobility. Built on an OpenTripPlanner-style plan surface.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "otp",
                "plan"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "fromPlace",
                  "value": "<string>",
                  "description": "(Required) Origin as \"lat,lon\"."
                },
                {
                  "disabled": false,
                  "key": "toPlace",
                  "value": "<string>",
                  "description": "(Required) Destination as \"lat,lon\"."
                },
                {
                  "disabled": false,
                  "key": "date",
                  "value": "<date>",
                  "description": "Travel date (YYYY-MM-DD). Defaults to today."
                },
                {
                  "disabled": false,
                  "key": "time",
                  "value": "<string>",
                  "description": "Travel time (HH:MM). Defaults to now."
                },
                {
                  "disabled": false,
                  "key": "arriveBy",
                  "value": "false",
                  "description": "When true, treat date/time as the desired arrival time."
                },
                {
                  "disabled": false,
                  "key": "mode",
                  "value": "<string>",
                  "description": "Comma-separated modes, e.g. TRANSIT,WALK,BICYCLE."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "Preferred response language (BCP 47).",
                "key": "Accept-Language",
                "value": "<string>"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
